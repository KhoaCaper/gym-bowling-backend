{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "chmod +x ./gradlew && ./gradlew clean build -x test --no-daemon"
  },
  "deploy": {
    "healthcheckPath": "/ping",
    "healthcheckTimeout": 900,
    "restartPolicyType": "on_failure",
    "startCommand": "java -Xmx512m -Xms256m -Dspring.profiles.active=railway -jar build/libs/gym-bowling-backend-0.0.1-SNAPSHOT.jar",
    "numReplicas": 1
  }
}
